{
  "name": "Streamora",
  "short_name": "Streamora",
  "description": "A sketchbook that plays movies. Your Real-Debrid, your profiles, saved in your own Google Drive.",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3e6cf",
